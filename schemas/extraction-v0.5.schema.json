{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Judicial KG development extraction contract",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.5.0"
    },
    "ontology_version": {
      "const": "0.5.0"
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "family_id": {
      "type": "string",
      "minLength": 1
    },
    "reference_status": {
      "const": "not_graph_gold"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "method": {
          "enum": [
            "model",
            "rule",
            "upstream_label"
          ]
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "method",
        "producer",
        "version",
        "run_id"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "processed_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "unprocessed_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "semantic_completeness": {
          "const": "not_assessed"
        }
      },
      "required": [
        "processed_fields",
        "unprocessed_fields",
        "semantic_completeness"
      ],
      "additionalProperties": false
    },
    "actors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actor"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "mentions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mention"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "contexts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/context"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "roles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/role"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "statements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/statement"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "object_mentions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object_mention"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "object_links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object_link"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "collectives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/collective"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "collective_mentions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/collective_mention"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "collective_memberships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/collective_membership"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "collective_participations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/collective_participation"
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "ontology_version",
    "document_id",
    "family_id",
    "reference_status",
    "provenance",
    "coverage",
    "actors",
    "mentions",
    "contexts",
    "roles",
    "events",
    "statements",
    "objects",
    "object_mentions",
    "object_links",
    "collectives",
    "collective_mentions",
    "collective_memberships",
    "collective_participations"
  ],
  "additionalProperties": false,
  "$defs": {
    "span": {
      "type": "object",
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "field_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_pointer": {
          "type": "string",
          "pattern": "^/"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "offset_space": {
          "const": "decoded_published_field_unicode_codepoints"
        }
      },
      "required": [
        "document_id",
        "field",
        "field_sha256",
        "source_pointer",
        "start",
        "end",
        "quote",
        "offset_space"
      ],
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "actor_type": {
          "enum": [
            "person",
            "organization",
            "court",
            "unknown"
          ]
        },
        "mention_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "actor_type",
        "mention_ids"
      ],
      "additionalProperties": false
    },
    "mention": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "kind": {
          "enum": [
            "name",
            "pronoun",
            "description"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/span"
        }
      },
      "required": [
        "id",
        "actor_id",
        "kind",
        "evidence"
      ],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "kind": {
          "enum": [
            "party_claim",
            "party_defense",
            "court_finding",
            "court_reasoning",
            "court_disposition",
            "court_report",
            "quoted_material",
            "procedural_record",
            "unknown"
          ]
        },
        "parent_context_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "attributed_actor_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "assertion_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "kind",
        "parent_context_id",
        "evidence",
        "attributed_actor_ids",
        "assertion_evidence"
      ],
      "additionalProperties": false
    },
    "role": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "role": {
          "enum": [
            "plaintiff",
            "defendant",
            "third_party",
            "appellant",
            "appellee",
            "lender",
            "borrower",
            "guarantor",
            "agent",
            "other"
          ]
        },
        "context_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "polarity": {
          "enum": [
            "affirmed",
            "negated",
            "uncertain",
            "conditional"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "actor_id",
        "role",
        "context_id",
        "polarity",
        "evidence"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "event_type": {
          "enum": [
            "loan_agreement",
            "funds_transfer",
            "repayment",
            "guarantee",
            "demand",
            "litigation",
            "other"
          ]
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "actor_id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "role": {
                "enum": [
                  "lender",
                  "borrower",
                  "transferor",
                  "transferee",
                  "guarantor",
                  "claimant",
                  "respondent",
                  "other"
                ]
              }
            },
            "required": [
              "actor_id",
              "role"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "context_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "polarity": {
          "enum": [
            "affirmed",
            "negated",
            "uncertain",
            "conditional"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "event_type",
        "participants",
        "context_id",
        "polarity",
        "evidence"
      ],
      "additionalProperties": false
    },
    "statement": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "subject_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "predicate": {
          "enum": [
            "principal_amount",
            "transfer_amount",
            "repayment_amount",
            "interest_amount",
            "outstanding_amount",
            "interest_rate",
            "event_date",
            "repayment_deadline",
            "legal_basis",
            "other"
          ]
        },
        "value": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "money",
                "rate",
                "date",
                "text"
              ]
            },
            "raw": {
              "type": "string",
              "minLength": 1
            },
            "normalized": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "unit": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "raw",
            "normalized",
            "unit"
          ],
          "additionalProperties": false
        },
        "context_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "polarity": {
          "enum": [
            "affirmed",
            "negated",
            "uncertain",
            "conditional"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "subject_id",
        "predicate",
        "value",
        "context_id",
        "polarity",
        "evidence"
      ],
      "additionalProperties": false
    },
    "object": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "object_type": {
          "enum": [
            "project",
            "platform",
            "instrument",
            "other"
          ]
        },
        "mention_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "object_type",
        "mention_ids"
      ],
      "additionalProperties": false
    },
    "object_mention": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "object_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "context_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "evidence": {
          "$ref": "#/$defs/span"
        }
      },
      "required": [
        "id",
        "object_id",
        "context_id",
        "evidence"
      ],
      "additionalProperties": false
    },
    "object_link": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "object_mention_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "relation": {
          "const": "involves_object"
        },
        "context_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "polarity": {
          "enum": [
            "affirmed",
            "negated",
            "uncertain",
            "conditional"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "object_mention_id",
        "event_id",
        "relation",
        "context_id",
        "polarity",
        "evidence"
      ],
      "additionalProperties": false
    },
    "collective": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "context_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "collective_type": {
          "enum": [
            "people_group",
            "organization_group",
            "adjudicative_panel",
            "other"
          ]
        },
        "membership_status": {
          "enum": [
            "unknown",
            "partial",
            "explicit"
          ]
        },
        "mention_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "context_id",
        "collective_type",
        "membership_status",
        "mention_ids"
      ],
      "additionalProperties": false
    },
    "collective_mention": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "collective_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "context_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "evidence": {
          "$ref": "#/$defs/span"
        }
      },
      "required": [
        "id",
        "collective_id",
        "context_id",
        "evidence"
      ],
      "additionalProperties": false
    },
    "collective_membership": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "collective_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "context_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "polarity": {
          "enum": [
            "affirmed",
            "negated",
            "uncertain",
            "conditional"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "collective_id",
        "actor_id",
        "context_id",
        "polarity",
        "evidence"
      ],
      "additionalProperties": false
    },
    "collective_participation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "collective_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "role": {
          "enum": [
            "lender",
            "borrower",
            "transferor",
            "transferee",
            "guarantor",
            "claimant",
            "respondent",
            "other"
          ]
        },
        "context_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "polarity": {
          "enum": [
            "affirmed",
            "negated",
            "uncertain",
            "conditional"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "collective_id",
        "event_id",
        "role",
        "context_id",
        "polarity",
        "evidence"
      ],
      "additionalProperties": false
    }
  }
}
